\bprotected void renderContents\(GuiGraphicsExtractor	protected void extractContents(GuiGraphicsExtractor
\bInventoryScreen\.renderEntityInInventoryFollowsMouse\(	InventoryScreen.extractEntityInInventoryFollowsMouse(
\bGui\.getMobEffectSprite\(	net.minecraft.client.gui.Hud.getMobEffectSprite(
