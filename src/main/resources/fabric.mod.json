{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Kegare: a cursed-energy combat framework for PvP with friends.",
  "authors": ["cnethuka"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.cnethuka.kegare.Kegare"],
    "client": ["com.cnethuka.kegare.client.KegareClient"],
    "fabric-datagen": ["com.cnethuka.kegare.data.KegareDataGen"]
  },
  "mixins": ["${mod_id}.mixins.json", "${mod_id}-platform.mixins.json", "${mod_id}-events.mixins.json", "${mod_id}-client-events.mixins.json", "${mod_id}-cworld.mixins.json"],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_release}",
    "fabric-api": "*",
    "forgeconfigapiport": "*",
    "player_animation_library": "*"
  },
  "suggests": { "trinkets": "*" },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/world/entity/Entity": ["com/cnethuka/kegare/platform/attachment/KHolder"],
      "net/minecraft/world/level/Level": ["com/cnethuka/kegare/platform/attachment/KHolder"]
    }
  }
}
